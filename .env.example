# Copy this file to .env and fill in the values.

# --- LLM (any OpenAI-compatible provider) -------------------------------
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults point at OpenAI):
# IGVAULT_LLM_BASE_URL=https://openrouter.ai/api/v1
# IGVAULT_LLM_MODEL=openai/gpt-4o-mini
# IGVAULT_EMBED_MODEL=text-embedding-3-small

# --- Instagram -----------------------------------------------------------
# Your Instagram username. The password is asked interactively (never stored).
IGVAULT_LOGIN=your_instagram_username

# Optional: set the password here for unattended runs. Not recommended.
# IGVAULT_PASSWORD=
